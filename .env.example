# ==============================================
# PROSPECT AI - AMBIENTE DE CONFIGURAÇÃO (.env)
# ==============================================

# Aplicação
ENVIRONMENT=development
APP_NAME=Prospect AI
SECRET_KEY=prospect_ai_super_secret_jwt_key_change_in_production_32chars_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Banco de Dados PostgreSQL
POSTGRES_USER=prospect_user
POSTGRES_PASSWORD=prospect_secret_pass
POSTGRES_DB=prospect_ai_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://prospect_user:prospect_secret_pass@postgres:5432/prospect_ai_db

# Redis & Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Regras de Negócio de Envio (Parâmetros Iniciais Padrão)
DAILY_CONTACT_LIMIT=30
TIMEZONE=America/Sao_Paulo
SENDING_START_HOUR=7
SENDING_START_MINUTE=0
SENDING_END_HOUR=18
SENDING_END_MINUTE=30
MIN_INTERVAL_BETWEEN_CONTACTS_SEC=180
MAX_INTERVAL_BETWEEN_CONTACTS_SEC=360
FOLLOWUP_1_DELAY_HOURS=24
FOLLOWUP_2_DELAY_HOURS=48

# Evolution API (WhatsApp)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=
EVOLUTION_WEBHOOK_SECRET=

# Provedores de IA
DEFAULT_AI_PROVIDER=gemini
FALLBACK_AI_PROVIDER=groq
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
